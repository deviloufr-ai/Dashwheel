<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the paired cars' secrets and where the car was left never
     leave the phone, neither in a cloud backup nor in a transfer to a new
     phone. Pair again there instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="paired_units.xml" />
        <exclude domain="sharedpref" path="car_spot.xml" />
        <!-- The road recorder's clips: other people's cars and plates stay on this phone. -->
        <exclude domain="file" path="road_clips/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="paired_units.xml" />
        <exclude domain="sharedpref" path="car_spot.xml" />
        <exclude domain="file" path="road_clips/" />
    </device-transfer>
</data-extraction-rules>
