<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path name="car_logs" path="car_logs/" />
    <!-- Photos of the car taken for its picture (CarFromPhotos). -->
    <cache-path name="car_photos" path="car_photos/" />
    <!-- The registration certificate's photo, read on the phone then deleted (RegistrationCard). -->
    <cache-path name="registration" path="registration/" />
    <!-- A warning light or a service booklet page, sent to the car's AI then deleted (PhotoAskCard). -->
    <cache-path name="photo_question" path="photo-question/" />
    <!-- The companion's own update, handed to Android's installer (CompanionUpdate). -->
    <cache-path name="updates" path="updates/" />
    <!-- The road recorder's clips, shared by the driver (RoadRecorder). -->
    <files-path name="road_clips" path="road_clips/" />
</paths>
