    <string name="road_experimental">Experimental</string>
    <string name="rec_title">Gravar a estrada</string>
    <string name="rec_detail">Enquanto o Vigia da estrada funciona, os últimos dois minutos de estrada ficam neste telemóvel. Uma pancada, uma travagem brusca, um aviso, os quatro piscas ou um toque guardam um clipe de um minuto, com a hora, o local e a velocidade do carro escritos na imagem.</string>
    <string name="rec_legal">Permitido na maioria dos países, restrito nalguns (Áustria, Portugal). Os clipes ficam neste telemóvel, nada é enviado para lado nenhum e não se grava som.</string>
    <string name="rec_clips_title">Clipes</string>
    <string name="rec_no_clips">Ainda sem clipes. Um é guardado quando algo acontece, ou quando toca em Guardar clipe.</string>
