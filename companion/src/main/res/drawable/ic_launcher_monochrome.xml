<?xml version="1.0" encoding="utf-8"?>
<!--
    The Dashwheel mark in one colour, for themed icons (Android 13+): a D whose stem is three dashboard tiles and whose bowl
    is a steering wheel's rim, with its hub. Kept inside the 66 dp safe circle
    of the 108 dp adaptive canvas, so every launcher mask shows all of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The three tiles of the stem. -->
    <path
        android:pathData="M36.2,31 h3.6 a3.2,3.2 0 0 1 3.2,3.2 v6.1 a3.2,3.2 0 0 1 -3.2,3.2 h-3.6 a3.2,3.2 0 0 1 -3.2,-3.2 v-6.1 a3.2,3.2 0 0 1 3.2,-3.2 z"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M36.2,47.75 h3.6 a3.2,3.2 0 0 1 3.2,3.2 v6.1 a3.2,3.2 0 0 1 -3.2,3.2 h-3.6 a3.2,3.2 0 0 1 -3.2,-3.2 v-6.1 a3.2,3.2 0 0 1 3.2,-3.2 z"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M36.2,64.5 h3.6 a3.2,3.2 0 0 1 3.2,3.2 v6.1 a3.2,3.2 0 0 1 -3.2,3.2 h-3.6 a3.2,3.2 0 0 1 -3.2,-3.2 v-6.1 a3.2,3.2 0 0 1 3.2,-3.2 z"
        android:fillColor="#FFFFFFFF" />
    <!-- The rim: the bowl of the D. -->
    <path
        android:pathData="M49.5,34.75 H54.5 A19.25,19.25 0 0 1 54.5,73.25 H49.5"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFFFF" />
    <!-- The hub. -->
    <path
        android:pathData="M56,49.4 a4.6,4.6 0 1 1 0,9.2 a4.6,4.6 0 1 1 0,-9.2 z"
        android:strokeWidth="3.2"
        android:strokeColor="#FFFFFFFF" />
</vector>
