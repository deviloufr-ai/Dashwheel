<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only styles the window before Compose draws; dark like the launcher. -->
    <style name="Theme.Companion" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B1020</item>
        <item name="android:colorAccent">#5B8DEF</item>
    </style>

    <!-- "Send to car" shows no window: only its toast. -->
    <style name="Theme.Companion.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
