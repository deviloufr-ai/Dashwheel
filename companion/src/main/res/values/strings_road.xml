    <string name="road_lane_looking">Looking for the lane</string>
    <string name="road_speed">%1$d km/h</string>
    <string name="road_horizon_hint">Drag the dotted line onto the horizon</string>
    <string name="road_lead_m">%1$d m</string>
    <string name="road_warn_collision">Brake</string>
    <string name="road_warn_lane">Mind your lane</string>
    <string name="road_warn_close">Too close</string>
    <string name="road_warn_moved_off">Traffic is moving</string>
    <string name="road_dim">Dim</string>
