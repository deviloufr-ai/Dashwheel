<resources>
    <!-- Road watch (RoadWatchActivity.kt): the phone behind the windscreen reads the road ahead for the car's warnings. -->
    <string name="road_title">Road watch</string>
    <string name="road_detail">Put the phone in a holder behind the windscreen: its camera watches the road, and the car warns you of a car ahead coming up fast, a wheel on the line, or following too close.</string>
    <string name="road_start">Start Road watch</string>
    <string name="road_model_get">Get the vehicle finder, 7.6 MB</string>
    <string name="road_model_retry">Try again</string>
    <string name="road_model_getting">Getting the vehicle finder: %1$d%%</string>
    <string name="road_model_failed">The vehicle finder could not be fetched. Check the phone\'s internet, then try again.</string>
    <string name="road_model_none">Without the vehicle finder, only the lane is watched.</string>
    <string name="road_note">A help, not a safety system: keep your eyes on the road. Keep the phone charging and out of strong sun.</string>
    <string name="road_camera_needed">Road watch needs the camera to see the road.</string>
    <string name="road_allow_camera">Allow the camera</string>
    <string name="road_linked">Warnings on %1$s</string>
    <string name="road_not_linked">No car linked: warnings on this phone</string>
