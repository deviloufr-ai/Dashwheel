    <!-- The road recorder (RoadRecorder.kt, RoadWatchCard.kt): clips of the road kept on the phone. -->
    <string name="road_experimental">Experimental</string>
    <string name="rec_title">Record the road</string>
    <string name="rec_detail">While Road watch runs, the last two minutes of the road are kept on this phone. A knock, a hard brake, a warning, the hazard lights or a tap keep a one-minute clip, with the time, the place and the car’s speed written into the picture.</string>
    <string name="rec_legal">Allowed in most countries, restricted in a few (Austria, Portugal). Clips stay on this phone, nothing is sent anywhere, and no sound is recorded.</string>
    <string name="rec_clips_title">Clips</string>
    <string name="rec_no_clips">No clips yet. One is kept when something happens, or when you tap Keep clip.</string>
