<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build's manifest, merged over the main one. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A Play app updates through Play alone (its policy forbids an app
         replacing itself any other way), so the GitHub updater stays idle
         here (Edition.updatesFromGitHub) and never needs to install an APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

</manifest>
