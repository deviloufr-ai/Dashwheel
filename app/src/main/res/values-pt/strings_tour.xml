<resources>
    <!-- First-run tour (TourScreen.kt): six tips over the real dashboard -->
    <string name="tour_welcome_kicker">Bem-vindo ao Dashwheel</string>
    <string name="tour_welcome_title">Uma visita rápida</string>
    <string name="tour_welcome_body">Algumas dicas curtas. Cerca de um minuto. Pode parar quando quiser.</string>
    <string name="tour_topic_swipe">Mudar de painel</string>
    <string name="tour_topic_arrange">Mover e aumentar</string>
    <string name="tour_topic_add">Adicionar</string>
    <string name="tour_topic_look">Mudar o aspeto</string>
    <string name="tour_topic_obd">Dados do carro</string>
    <string name="tour_topic_hands">Mãos livres</string>
    <string name="tour_show_me">Mostrar</string>
    <string name="tour_not_now">Agora não</string>
    <string name="tour_tip">Dica %1$d de %2$d</string>
    <string name="tour_skip">Saltar</string>
    <string name="tour_next">Seguinte</string>
    <string name="tour_back">Voltar</string>
    <string name="tour_finish">Terminar</string>
    <string name="tour_read_aloud">Ler em voz alta</string>
    <string name="tour_swipe_title">Deslize para mudar de painel</string>
    <string name="tour_swipe_body">O início está no meio. Deslize para a esquerda ou direita para mais dois, e para cima ou baixo a partir do início para mais quatro.</string>
    <string name="tour_try_swipe">Experimente: deslize o ecrã</string>
    <string name="tour_arrange_title">Mover e aumentar mosaicos</string>
    <string name="tour_arrange_body">Mantenha um mosaico premido e arraste-o para o mover. Puxe o canto para o aumentar.</string>
    <string name="tour_arrange_hint">Mais tarde, abra isto no menu, Editar painéis.</string>
    <string name="tour_add_title">Adicionar um widget ou uma app</string>
    <string name="tour_add_body">Toque em Adicionar para pôr música, dados do carro, meteorologia ou uma app neste painel.</string>
    <string name="tour_add_hint">Com pressa? Os modelos enchem um painel inteiro de uma vez.</string>
    <string name="tour_look_title">Ao seu gosto</string>
    <string name="tour_look_body">Abra o menu, depois Definições e depois Aspeto. Escolha um tema e cores de dia ou de noite.</string>
    <string name="tour_obd_title">Ligue o adaptador OBD</string>
    <string name="tour_obd_body">Vai na tomada debaixo do volante. Emparelhe-o uma vez nas definições Bluetooth do Android e o Dashwheel volta a ligar-se sozinho.</string>
    <string name="tour_obd_off">Desligado</string>
    <string name="tour_obd_looking">A procurar</string>
    <string name="tour_obd_connected">Ligado</string>
    <string name="tour_hands_title">Olhos na estrada</string>
    <string name="tour_hands_body">Os botões do volante podem mudar de painel, saltar músicas ou abrir o assistente de voz. O Dashwheel avisa sozinho quando algo importa.</string>
    <string name="tour_hands_hint">Configure os botões em Definições, Condução, Botões do volante.</string>
    <string name="tour_wheel_dashboard">Painel seguinte</string>
    <string name="tour_wheel_music">Música</string>
    <string name="tour_wheel_voice">Assistente de voz</string>
    <string name="tour_wheel_alerts">Avisos falados</string>
    <string name="tour_done_title">Tudo pronto</string>
    <string name="tour_done_body">Veja esta visita outra vez em Definições, Acerca.</string>
    <string name="tour_start_driving">Arrancar</string>
    <string name="tour_settings_row">Visita rápida</string>
