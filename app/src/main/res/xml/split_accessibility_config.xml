<?xml version="1.0" encoding="utf-8"?>
<!--
  Config for SplitAccessibilityService. It drives the system split path via
  performGlobalAction(GLOBAL_ACTION_TOGGLE_SPLIT_SCREEN). It watches window changes
  (flagRetrieveInteractiveWindows + canRetrieveWindowContent) to detect split mode
  from the two app windows' bounds, and — when the user taps the floating swap
  button — to read only those two windows' package names so it can recreate the
  split with the apps reversed (this ROM has no working swap gesture). It reads
  window types, bounds and owning package names; of the window content, only the
  view with the keyboard focus, when text comes from the phone, to type it there
  (PhoneKeyboard).
  notificationTimeout batches the events: a split settles in several window
  changes, and only the swap button's show / hide follows them, so a fraction
  of a second later costs nothing and saves a window-list fetch per change.
  flagRequestFilterKeyEvents: hardware keys pass through the service first,
  so a learned steering wheel button works whatever app is in front
  (SteeringWheelStore), and the keys the driver chose turn the second
  screen's cluster page (SecondScreenController.onKey); keys that aren't
  learned go on untouched.
  While Waze runs, window content changes are asked for too (at run time,
  SplitAccessibilityService.watchContent; GitHub edition only): Waze's guidance
  banner is read from them (WazeScreen), as its notification carries no turn.
  isAccessibilityTool="false" (Android 12+): Dashwheel is not a tool for users
  with disabilities, which Google Play asks apps to state.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:isAccessibilityTool="false"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="300"
    android:description="@string/split_a11y_description" />
