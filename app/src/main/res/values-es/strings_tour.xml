<resources>
    <!-- First-run tour (TourScreen.kt): six tips over the real dashboard -->
    <string name="tour_welcome_kicker">Bienvenido a Dashwheel</string>
    <string name="tour_welcome_title">Un repaso rápido</string>
    <string name="tour_welcome_body">Unos consejos cortos. Un minuto más o menos. Puedes parar cuando quieras.</string>
    <string name="tour_topic_swipe">Cambiar de panel</string>
    <string name="tour_topic_arrange">Mover y ampliar</string>
    <string name="tour_topic_add">Añadir</string>
    <string name="tour_topic_look">Cambiar el aspecto</string>
    <string name="tour_topic_obd">Datos del coche</string>
    <string name="tour_topic_hands">Manos libres</string>
    <string name="tour_show_me">Muéstramelo</string>
    <string name="tour_not_now">Ahora no</string>
    <string name="tour_tip">Consejo %1$d de %2$d</string>
    <string name="tour_skip">Saltar</string>
    <string name="tour_next">Siguiente</string>
    <string name="tour_back">Atrás</string>
    <string name="tour_finish">Terminar</string>
    <string name="tour_read_aloud">Leer en voz alta</string>
    <string name="tour_swipe_title">Desliza para cambiar de panel</string>
    <string name="tour_swipe_body">Inicio está en el centro. Desliza a izquierda o derecha para los dos de al lado. Puede haber más paneles arriba y abajo.</string>
    <string name="tour_try_swipe">Pruébalo: desliza la pantalla</string>
    <string name="tour_arrange_title">Mover y ampliar mosaicos</string>
    <string name="tour_arrange_body">Toca una ficha para sus opciones, mantén para moverla, arrastra su esquina para cambiar el tamaño. Mantener el propio panel también inicia la organización.</string>
    <string name="tour_arrange_hint">Más tarde, ábrelo desde el menú, Editar paneles.</string>
    <string name="tour_add_title">Añadir un widget o una app</string>
    <string name="tour_add_body">Toca Añadir para poner música, datos del coche, el tiempo o cualquier app en este panel.</string>
    <string name="tour_add_hint">¿Con prisa? Las plantillas llenan un panel entero de una vez.</string>
    <string name="tour_look_title">A tu gusto</string>
    <string name="tour_look_body">Abre el menú, luego Ajustes y luego Aspecto. Elige un tema y colores de día o de noche.</string>
    <string name="tour_obd_title">Conecta el adaptador OBD</string>
    <string name="tour_obd_body">Va en la toma bajo el volante. Vincúlalo una vez en los ajustes Bluetooth de Android y Dashwheel se reconecta solo.</string>
    <string name="tour_obd_off">Sin conectar</string>
    <string name="tour_obd_looking">Buscando</string>
    <string name="tour_obd_connected">Conectado</string>
    <string name="tour_hands_title">La vista en la carretera</string>
    <string name="tour_hands_body">Los botones del volante pueden cambiar de panel, saltar canciones o abrir el asistente de voz. Dashwheel avisa solo cuando algo importa.</string>
    <string name="tour_hands_hint">Configura los botones en Ajustes, Conducción, Botones del volante.</string>
    <string name="tour_wheel_dashboard">Panel siguiente</string>
    <string name="tour_wheel_music">Música</string>
    <string name="tour_wheel_voice">Asistente de voz</string>
    <string name="tour_wheel_alerts">Avisos hablados</string>
    <string name="tour_done_title">Todo listo</string>
    <string name="tour_done_body">Vuelve a ver este repaso en Ajustes, Sistema, Acerca de.</string>
    <string name="tour_start_driving">A conducir</string>
    <string name="tour_settings_row">Repaso rápido</string>
    <string name="tour_settings_row_detail">Seis consejos cortos sobre el panel</string>
