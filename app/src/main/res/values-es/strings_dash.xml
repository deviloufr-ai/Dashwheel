    <string name="dash_theme_futuristic">Futurista</string>
    <string name="dash_theme_futuristic_desc">Tu coche como holograma sobre una rejilla de luz en movimiento, con sus datos señalados.</string>
    <string name="dash_theme_simple">Sencillo</string>
    <string name="dash_theme_simple_desc">Cifras grandes y legibles, tu coche iluminado como en un salón, pocos botones grandes.</string>
    <string name="dash_theme_modern">Moderno</string>
    <string name="dash_theme_modern_desc">Tarjetas de cristal esmerilado sobre una ciudad en 3D, la ruta iluminada.</string>
    <string name="dash_theme_motorsport">Motor</string>
    <string name="dash_theme_motorsport_desc">La pantalla de un coche de carreras: luces de cambio, tiempos por sector, marco del color de la bandera.</string>
    <string name="dash_theme_anime">Anime</string>
    <string name="dash_theme_anime_desc">Viñetas de cómic en un cielo de atardecer, tu coche como pegatina que habla.</string>
    <string name="dash_theme_racing">Carreras</string>
    <string name="dash_theme_racing_desc">Una noche de neón: sol a rayas, esferas y minimapa de juego de carreras.</string>
    <string name="dash_theme_panorama">Panorama</string>
    <string name="dash_theme_panorama_desc">Una banda de cristal curva con segmentos iluminados, tu coche sobre un pedestal iluminado y un dock de volante.</string>
    <string name="dash_theme_liquid">Líquido</string>
    <string name="dash_theme_liquid_desc">Cristal que curva la luz sobre un fondo vivo, tu coche girando en el centro.</string>
    <string name="dash_theme_expressive">Expresivo</string>
    <string name="dash_theme_expressive_desc">Formas rotundas y los colores de la música que suena; cada widget tiene su forma.</string>
    <string name="dash_theme_kinetic">Cinético</string>
    <string name="dash_theme_kinetic_desc">Primero las palabras: el próximo giro en letras grandes en movimiento, el resto pasando debajo.</string>
    <string name="dash_theme_glyph">Glifo</string>
    <string name="dash_theme_glyph_desc">Cifras de puntos sobre un panel claro, teclas que parecen reales y franjas de luz en los bordes.</string>
    <string name="dash_theme_windshield">Parabrisas</string>
    <string name="dash_theme_windshield_desc">Una franja arriba con todo lo que miras de un vistazo, sobre una carretera dibujada de noche.</string>
    <string name="dash_theme_terrain">Terreno</string>
    <string name="dash_theme_terrain_desc">Tu coche sobre un paisaje de curvas de nivel, un problema señalado en la pieza misma.</string>
    <string name="dash_theme_ambient">Ambiente</string>
    <string name="dash_theme_ambient_desc">Un campo de luz con pocas palabras: un brillo cálido sube por el lado del próximo giro.</string>
    <string name="dash_theme_brutal">Brutal</string>
    <string name="dash_theme_brutal_desc">Colores planos y vivos, contornos gruesos y letras enormes, legible a pleno sol.</string>
    <string name="dash_theme_clay">Arcilla</string>
    <string name="dash_theme_clay_desc">Formas pastel suaves como plastilina, teclas redondas grandes y una flecha 3D mullida.</string>
    <string name="dash_theme_chrome">Cromo</string>
    <string name="dash_theme_chrome_desc">Letras de cromo líquido, fichas holográficas y una gota de metal que se mueve con la música.</string>
    <string name="dash_theme_spatial">Espacial</string>
    <string name="dash_theme_spatial_desc">Ventanas de cristal flotando a distintas profundidades sobre una ciudad en 3D de noche.</string>
    <string name="dash_theme_paper">Papel</string>
    <string name="dash_theme_paper_desc">Tinta sobre gris como el papel electrónico: un mapa de puntos, datos sencillos y nada que se mueva.</string>
