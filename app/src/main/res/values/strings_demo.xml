    <!-- The mechanic's canned advice on the demo's fault code (P0401, EGR flow too low) -->
    <string name="demo_p0401_summary">The EGR valve isn\'t letting enough exhaust gas back in, most likely soot. Fine to drive; have it cleaned soon.</string>
    <string name="demo_p0401_meaning">EGR flow too low</string>
    <string name="demo_p0401_explanation">The engine sends some exhaust back to the intake to cut emissions. The computer asked for more than it got, which on this engine usually means a valve clogged with soot.</string>
    <string name="demo_p0401_cause_1">EGR valve clogged with soot</string>
    <string name="demo_p0401_cause_2">EGR valve stuck, or its motor failing</string>
    <string name="demo_p0401_cause_3">Blocked EGR cooler or pipe</string>
    <string name="demo_p0401_check_first">Take the EGR valve off and look for soot</string>
    <string name="demo_p0401_repair">Clean the valve, or replace it if it sticks</string>
    <string name="demo_p0401_cost">About 80 to 150 € for a cleaning, 250 to 400 € for a new valve</string>
    <string name="demo_p0401_driving">Yes. Expect a slightly rough idle and higher fuel use until it\'s fixed.</string>
