<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings dialog (also the menu item) -->
    <string name="ai_title">AI mechanic</string>
    <string name="ai_explanation">A new fault code is explained by Gemini and spoken. Sent to Google: the codes, engine readings, car model, and your voice when you ask a question out loud.</string>
    <string name="ai_activation_code">Activation code</string>
    <string name="ai_activation_hint">Unlocks the built-in key</string>
    <string name="ai_activate">Activate</string>
    <string name="ai_own_key">Or your own Gemini API key</string>
    <string name="ai_key">Gemini API key</string>
    <string name="ai_key_hint">Free at aistudio.google.com → Get API key</string>
    <string name="ai_language">Language</string>
    <string name="ai_language_auto">Same as app</string>
    <string name="ai_test">Test</string>
    <string name="ai_done">Done</string>

    <!-- Settings dialog: test results -->
    <string name="ai_test_ok">Gemini works (%1$s).</string>
    <string name="ai_test_activated_ok">Activated. Gemini works (%1$s).</string>
    <string name="ai_test_failed">Didn\'t work: %1$s</string>
    <string name="ai_test_activated_unreachable">Activated. Gemini not reachable yet: %1$s</string>
    <string name="ai_test_waiting">Contacting Google… %1$d s</string>
    <string name="ai_wrong_code">Wrong activation code</string>
    <string name="ai_no_voice">No %1$s voice on this unit: add one in Android Settings → Text-to-speech.</string>

    <!-- Spoken by the car, in the mechanic's language (resolved with the AI language, not the screen's) -->
    <string name="ai_say_ready">The AI mechanic is ready.</string>
    <plurals name="ai_say_new_codes">
        <item quantity="one">%1$d new engine fault code: %2$s. Details are on screen.</item>
        <item quantity="other">%1$d new engine fault codes: %2$s. Details are on screen.</item>
    </plurals>
    <string name="ai_say_overheat">Warning, the engine is overheating: %1$d degrees. Pull over when it\'s safe and switch the engine off.</string>
    <string name="ai_say_not_charging">The battery isn\'t charging: %1$s volts with the engine running. Head to a garage and switch off what you don\'t need.</string>
    <string name="ai_say_weak_battery">The battery is weak: %1$s volts with the engine off. Get it tested soon.</string>

    <!-- Fault codes tile: labels around the AI advice (in the mechanic's language, like the advice) -->
    <string name="ai_verdict_ok">No sign of urgency</string>
    <string name="ai_verdict_soon">Get it checked soon</string>
    <string name="ai_verdict_stop">Stop driving</string>
    <!-- When the built-in rules rate a fault more serious than the AI did (spoken, and shown in the verdict) -->
    <string name="ai_rules_stop">This fault can damage the engine: stop when it\'s safe and have it checked before driving on.</string>
    <string name="ai_rules_soon">This fault needs a garage within days: drive gently until then.</string>
    <string name="ai_rules_raised">Rated more serious by the built-in safety rules than by the AI.</string>
    <string name="ai_disclaimer">AI advice (%1$s): it can be wrong. Confirm with a garage before any repair.</string>
    <string name="ai_disclaimer_gemini" translatable="false">Gemini</string>
    <string name="ai_details_parked">The details are for when you\'re parked. You can still ask your question out loud.</string>
    <string name="ai_check_first">Check first: %1$s</string>
    <string name="ai_details">Details</string>
    <string name="ai_close">Close</string>
    <string name="ai_detail_overview">Overview</string>
