<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Activity theme. Kept minimal because the UI is drawn with Jetpack
        Compose; this theme only styles the window before Compose takes over.
    -->
    <style name="Theme.OpenAutoDash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Dark, low-glare window for driving safety. -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- See-through: the head unit's status bar, forced on while an app window
             is docked, shows the dashboard's own background (the theme's colours). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Transparent too: the bar is hidden (immersive), and a painted bar colour showed as a
             strip whenever a pop-up window took the focus. -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- A see-through activity that holds one dialog (AccessDisclosureActivity). -->
    <style name="Theme.OpenAutoDash.Transparent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
