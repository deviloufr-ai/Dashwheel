    <!-- First-run tour (TourScreen.kt): six tips over the real dashboard -->
    <string name="tour_welcome_kicker">Welkom bij Dashwheel</string>
    <string name="tour_welcome_title">Een korte rondleiding</string>
    <string name="tour_welcome_body">Zes korte tips. Ongeveer een minuut. Je kunt altijd stoppen.</string>
    <string name="tour_topic_swipe">Dashboard wisselen</string>
    <string name="tour_topic_arrange">Verplaatsen, vergroten</string>
    <string name="tour_topic_add">Toevoegen</string>
    <string name="tour_topic_look">Uiterlijk wijzigen</string>
    <string name="tour_topic_obd">Autogegevens</string>
