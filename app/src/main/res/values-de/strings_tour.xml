    <string name="tour_welcome_kicker">Willkommen bei Dashwheel</string>
    <string name="tour_welcome_title">Eine kurze Tour</string>
    <string name="tour_welcome_body">Ein paar kurze Tipps. Etwa eine Minute. Du kannst jederzeit aufhören.</string>
    <string name="tour_topic_swipe">Dashboard wechseln</string>
    <string name="tour_topic_arrange">Verschieben, vergrößern</string>
