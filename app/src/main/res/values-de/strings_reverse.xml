    <string name="reverse_switch">Dashwheels Rückfahransicht</string>
    <string name="reverse_switch_detail">Linien, die dem Lenkrad folgen, das Parkradar und dein Auto über der Rückfahrkamera. Aus, zeigt das Auto seine Kamera wie zuvor.</string>
