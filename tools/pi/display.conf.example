# Dashwheel display settings. Every line is optional; remove the # to use one.
# This file lives on the SD card's boot partition, so any computer can edit it.

# The name the head unit shows for this screen.
name=Dashwheel display

# Percent of each edge a TV-style (composite / RCA) monitor crops off.
# 0 for HDMI; 5 is typical for a headrest monitor on the composite output.
#overscan=5

# Force the picture size when the monitor reports none (composite has no EDID).
#width=720
#height=576

# kms: straight to the screen (the Pi). auto: a desktop window (testing on a computer).
#sink=kms

# The whole GStreamer chain for the video, reading H.264 on stdin, when the
# default (h264parse ! v4l2h264dec ! kmssink) doesn't suit a board.
#video_pipeline=fdsrc fd=0 ! h264parse ! v4l2h264dec ! kmssink sync=false

# The card turns read-only by itself once a head unit has paired, so cutting the
# power can't harm it. manual: keep it writable (install.sh --overlay does it by hand).
#read_only=manual

# The monitor's own brightness buttons, wired to these GPIOs through a divider
# (the buttons sit at ~4.6 V: 220 ohm from the button, 14.7 kohm to ground).
# The head unit then sets a day and a night level (Settings, Second screen).
#brightness_up_gpio=17
#brightness_down_gpio=27

# The map the display draws itself (a Map slot on the board, Simple display on):
# raster tiles, 256 px, with {z}, {x} and {y} in the address. Without tile_url the
# map shows the route and the car on a plain ground. A second address for night.
#tile_url=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
#tile_url_night=https://api.maptiler.com/maps/streets-v2-dark/256/{z}/{x}/{y}.png?key=YOUR_KEY
# Where fetched tiles are kept for the next drive. On a read-only card this folder
# is in memory and empties at each power-up: point it at a USB stick to keep them.
#tile_cache=/var/cache/dashwheel-display/tiles
# 15 shows a town, 16 its streets (default), 17 every house.
#map_zoom=16
