# The logo centred on the idle screen's background (Painter.BG_NIGHT, black), scaled down on small screens.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo = Image("logo.png");
w = Window.GetWidth();
h = Window.GetHeight();
scale = Math.Min(1, Math.Min(w * 0.5 / logo.GetWidth(), h * 0.6 / logo.GetHeight()));
if (scale < 1)
  logo = logo.Scale(logo.GetWidth() * scale, logo.GetHeight() * scale);
sprite = Sprite(logo);
sprite.SetX(Window.GetX() + (w - logo.GetWidth()) / 2);
sprite.SetY(Window.GetY() + (h - logo.GetHeight()) / 2);
